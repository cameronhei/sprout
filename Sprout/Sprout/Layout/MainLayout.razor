@inherits LayoutComponentBase

<div class="shell">
	<aside class="side">
		<div class="brand">
			<svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none"
				 stroke="var(--side-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M12 21v-9" />
				<path d="M12 12c0-4 2.5-6.5 7-7 0 4.5-2.5 7-7 7z" />
				<path d="M12 14c0-3.2-2-5.2-6-5.6 0 3.6 2 5.6 6 5.6z" />
			</svg>
			Sprout
		</div>
		<nav class="nav">
			<NavLink href="" Match="NavLinkMatch.All">Dashboard</NavLink>
			<NavLink href="work">All Work</NavLink>
			<NavLink href="projects">Projects &amp; Meetings</NavLink>
			<NavLink href="report">Weekly Report</NavLink>
		</nav>
		<div class="side-bottom">
			<nav class="nav">
				<NavLink href="settings">
					<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none"
						 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="12" cy="12" r="3" />
						<path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" />
					</svg>
					Settings
				</NavLink>
			</nav>
			<div class="local-note">
				<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none"
					 stroke="var(--side-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="4" y="11" width="16" height="10" rx="2" />
					<path d="M8 11V7a4 4 0 0 1 8 0v4" />
				</svg>
				<span>Stored only on this computer</span>
			</div>
		</div>
	</aside>
	<main class="content">
		<QuickAdd />
		<BackupReminder />
		<Toast />
		@Body
	</main>
</div>